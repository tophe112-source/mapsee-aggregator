# mapsee-aggregator — environment variables
#
# Copy to `.env.local` (gitignored) and fill in what you need, or set these as
# GitHub repo secrets for CI.
#
# THE IMPORTANT THING TO KNOW: almost everything here is optional. Every adapter
# checks for its own key and silently no-ops when it is unset, so the pipeline
# runs fine with only the first block filled in — you just ingest fewer sources.
# That is deliberate: a fork with no credentials should still work.
#
# Only SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are genuinely required, and
# only for the sync step. The ingest adapters write to a local store.json and
# need nothing.

# ---------------------------------------------------------------------------
# REQUIRED for syncing to the database
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key — the sync upserts past RLS.
# ⚠️ Never commit this, never expose it to a pull_request-triggered workflow,
#    and never put it in client code. It bypasses every row-level policy.
SUPABASE_SERVICE_ROLE_KEY=
# Profile id that owns aggregated events (they need a host row to hang off).
MAPSEE_HOST_PROFILE_ID=
# OPTIONAL, and deliberately not a secret. mapsee_indexnow.py reads the events
# it is about to announce with the ANON key — the same one already published in
# mapsee/site/js/config.js and shipped to every browser — so it can only ever
# see what an anonymous crawler could see, and cannot leak a private event to a
# search engine even if its query predicate were wrong. Leave blank to use the
# built-in default; set it only if you point the pipeline at a different project.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Ticketing APIs — the biggest sources by volume
# ---------------------------------------------------------------------------
# developer.ticketmaster.com — top source by event count. Rate limited to
# ~2 req/s, which is why the sweep is serial and slow.
TICKETMASTER_API_KEY=
# seatgeek.com/build
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
# Partner-gated: each of these no-ops entirely until its key is set.
DICE_API_KEY=
DICE_API_BASE=
AXS_API_KEY=
AXS_API_BASE=

# ---------------------------------------------------------------------------
# Eventbrite — official API
# ---------------------------------------------------------------------------
EVENTBRITE_API_TOKEN=
EVENTBRITE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Meetup — OAuth2 with a signed JWT assertion (hence pyjwt + cryptography).
# meetup_token.py mints the access token from these.
# ---------------------------------------------------------------------------
MEETUP_CLIENT_KEY=
MEETUP_MEMBER_ID=
MEETUP_SIGNING_KEY_ID=
# The RSA private key itself, PEM, newlines included.
MEETUP_PRIVATE_KEY=
# Short-lived; normally minted rather than set by hand.
MEETUP_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Civic / open data / outdoors — all free, most need only registration
# ---------------------------------------------------------------------------
# nps.gov/subjects/developer
NPS_API_KEY=
# ridb.recreation.gov
RECREATION_GOV_KEY=
SEOUL_OPEN_API_KEY=
THESPORTSDB_KEY=
USDA_LOCALFOOD_API_KEY=

# ---------------------------------------------------------------------------
# Enrichment
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Affiliate catalogs — currently dormant.
# affiliate_sources.json references these; both feeds are skipped while unset,
# so this whole block is a no-op until the affiliate programs approve us.
# ---------------------------------------------------------------------------
DOORDASH_FEED_URL=
UBEREATS_FEED_URL=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ACCESS_TOKEN=
UBER_AUTH_URL=
UBER_API_BASE=

# ---------------------------------------------------------------------------
# Local tuning — paths and budgets, not credentials. Sensible defaults apply
# when unset; you rarely need these outside debugging.
# ---------------------------------------------------------------------------
# Geocoding is the slow part (~1.1s per uncached venue via Photon), so the
# cache and the per-run budget are what keep feed runs bounded.
GEOCODE_CACHE=
GEOCODE_BUDGET_FILE=
GEOCODE_MAX_NEW=
ICS_FEED_CACHE=
# Pin "today" for reproducible test runs, e.g. 2026-08-02.
MAPSEE_TODAY=
