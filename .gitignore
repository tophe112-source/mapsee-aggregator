__pycache__/
*.pyc

# run artifacts + caches (restored in CI via actions/cache)
# NOT geocode_cache.json — it is committed on purpose. mapsee_ingest_markets.py
# derives a market's fingerprint from a geohash cell of its geocoded position,
# so a coordinate that moves between runs mints a duplicate row rather than
# moving a pin. That makes the cache identity-critical, and actions/cache (7-day
# idle eviction, never saved by a timed-out job) is not a place to keep identity.
# The warm cache still covers the other adapters — see aggregate-events.yml.
# _save_ledger writes the ledger aside and renames it into place; a run
# killed mid-write leaves this behind, never a half-written ledger.
curation_ledger.json.tmp
ics_feed_cache.json
ics_cursor.json
ics_cursor.json.tmp
jsonld_cursor.json
jsonld_cursor.json.tmp
kct_cursor.json
kct_cursor.json.tmp
natuurwerkdag_cache.json
natuurwerkdag_cache.json.tmp
# repair-cafe.ch's page cursor (mapsee_ingest_repaircafe_ch): Actions cache
# only, like the two above. Lost, it costs a cold walk of ~1,300 pages spread
# over three runs, never a wrong row.
repaircafe_ch_cursor.json
repaircafe_ch_cursor.json.tmp
# The rec group's absence baselines (mapsee_supabase_sync --retire-absent):
# Actions cache only. A local run leaves them behind; they are never history.
rec_absence_manifest.json
facility_hours_manifest.json
geocode_cache.warm.json
geo_budget.json
# The sync's Census answers and Spotify artist pages: Actions cache only.
census_cache.json
census_cache.json.tmp
spotify_cache.json
# Meetup's held first category per event (mapsee_meetup_category_cache):
# Actions cache only, its own pair. Lost, it costs one day of category flips.
meetup_category_cache.json
meetup_category_cache.json.tmp
# The far-row URL index mapsee_prune_cancelled writes on a full sweep and
# the near runs read: Actions cache only, its own pair. Lost, it costs the
# near runs their far hides until the next full sweep, never a wrong hide.
prune_url_index.json
prune_url_index.json.tmp
feeds_events.json
*.verified.json

# CI artifact: source-health.yml writes this for the issue body, and running the
# check locally leaves a copy behind that has no business in the repo.
health_report.md

# Cached OSM place lists, one file per hub. Derived data, tens of MB, and
# refetchable — it belongs in the Actions cache, not in history. The CURSOR
# (osm_food_cursor.json) is committed, because where we got to is not derivable.
osm_places_cache/
# The amenity adapter's copy of the same thing (osm_amenity_cache/<area>.json,
# 12,599 elements for DC alone). Same rule, same reason.
osm_amenity_cache/

# local credentials - never commit
.env
.env.local
eventbrite_local.json

# Festival run products; persistent discovery is stored by its dedicated job.
.venv/
tmp/
festival_events.json
festival_report.json
festival_discovery_state.json
festival_schedule_state.json
